// Prisma schema for the Course Project Management System.
// Only the account table exists in the scaffold (Prisma cannot generate a client
// from an empty schema). Team, Milestone, Submission, Feedback and Session arrive
// with their features — see Issue #8 (schema + seed), #6 (sessions) and the SDS.
//
// Migrations must stay additive (add tables/columns, never drop or rename in the
// same release) so the previous image still works after a Cloud Run rollback.

generator client {
  provider = "prisma-client-js"
  // Native target for local dev/CI plus the musl build used by node:24-alpine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SRS §2 / DEC-07: exactly one role per account.
enum Role {
  STUDENT
  SUPERVISOR
}

// SRS FR-01..03, NFR-01: accounts are seeded; only a bcrypt hash is stored.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  role         Role
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]

  @@map("users")
}

// F-01 / DEC-12: one row per signed-in browser. Only SHA-256(token) is stored;
// expires_at is fixed at login (8 h, NFR-04). Logout deletes the row.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}
