# Copy this file to ".env" and fill in your own local values.
# Never commit .env, and never paste real passwords into an AI chat or a screenshot.

# --- Required -----------------------------------------------------------------

# PostgreSQL used by Prisma (dev server, migrations, seed). The default matches
# docker-compose.yml (`docker compose up -d db`); change it for your own Postgres.
DATABASE_URL="postgresql://cpms:cpms@localhost:5433/cpms?schema=public"

# --- Optional (defaults shown) --------------------------------------------------

# Port the API listens on. Cloud Run injects its own value.
PORT=3000

# Interface the API binds to. Keep 0.0.0.0 so a container platform (Cloud Run)
# can reach it; 127.0.0.1 restricts a local run to this machine.
# HOST=0.0.0.0

# Browser origins allowed to call the API (comma-separated). Default: the Vite dev server.
CLIENT_ORIGINS="http://localhost:5173"

# "production" makes Express serve the built client (client/dist) on the same port.
NODE_ENV=development

# Absolute path of the built client served in production. Default: ../client/dist
# relative to the server (repo: client/dist; container: /app/client/dist).
# CLIENT_DIST_DIR=/absolute/path/to/client/dist

# --- Tests only -------------------------------------------------------------------

# Database for `npm test`; falls back to DATABASE_URL when unset.
# WARNING: every test run DROPS and recreates the "cpms_test" schema in this
# database (the "public" schema is never touched). Point it at a dev/CI database only.
# TEST_DATABASE_URL="postgresql://cpms:cpms@localhost:5433/cpms"
